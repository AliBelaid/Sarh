{
  "name": "sarh",
  "version": "0.1.0",
  "private": true,
  "description": "Sarh — Libyan Real Estate Registry + Digital Identity (LVCT)",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev": "concurrently --names \"API,WEB\" --prefix-colors \"cyan,magenta\" --kill-others-on-fail \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "dotnet run --project apps/api-dotnet/Sarh.Api.csproj",
    "dev:web": "pnpm --filter @sarh/web start",
    "db:reset": "pwsh ./scripts/db/run-migrations.ps1 -Server localhost -Reset",
    "db:migrate:ef": "dotnet run --project apps/api-dotnet -- --migrate",
    "db:reset:ef": "powershell -ExecutionPolicy Bypass -File scripts/db/migrate-ef.ps1 -Reset",
    "diagrams:render": "node docs/diagrams/render.mjs && node docs/diagrams/render-a4.mjs",
    "diagrams:classic": "node docs/diagrams/render-classic-local.mjs",
    "diagrams:pdf": "node docs/print-diagrams-pdf.mjs",
    "diagrams:pdf:classic": "node docs/print-classic-pdf.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "5.4.5"
  }
}
