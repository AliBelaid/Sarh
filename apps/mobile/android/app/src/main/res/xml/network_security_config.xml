<?xml version="1.0" encoding="utf-8"?>
<!--
  Sarh talks to the API over plain HTTP in local / LAN / demo deployments:
    * Android emulator: http://10.0.2.2:3001
    * USB device (adb reverse tcp:3001): http://localhost:3001
    * physical device on Wi-Fi: http://PC-LAN-IP:3001 (set via the SARH_API_URL dart-define)

  Android 9+ (targetSdk 28 or higher) blocks cleartext HTTP by default, which made
  every API call (starting with the login probe) fail silently, so the app could
  not sign in at all. Permit cleartext for the loopback / dev hosts the resolver
  probes, and (because a physical device reaches the PC at a machine-specific LAN
  IP that cannot be enumerated here) permit it at the base for the demo build too.

  PRODUCTION: serve the API over HTTPS and set base-config cleartextTrafficPermitted
  to false (or delete this file and the networkSecurityConfig reference in
  AndroidManifest.xml).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
