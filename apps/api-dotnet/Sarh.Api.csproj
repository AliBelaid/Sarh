<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <!-- Real on-chain mint/transfer/read for the Sepolia (and any EVM) path.
         Bound by EthereumBlockchainService; only exercised when
         Sarh:Blockchain:Mode is "real"/"ethereum". -->
    <PackageReference Include="Nethereum.Web3" Version="4.29.0" />
    <PackageReference Include="QuestPDF" Version="2024.7.3" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Detached CMS/PKCS#7 deed signatures (SignedCms/CmsSigner). Type-forwarded
         in net8, so the package reference is required even though the namespace
         is in the BCL. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <!--
    Embed the authoritative T-SQL (the numbered migrations + the login bootstrap) into the
    assembly so EF Core migrations replay them on any machine — and in a published build —
    without the infra/ folder being present on disk. The "SarhSql." logical-name prefix is
    what SqlMigrationRunner and EfDatabaseBootstrapper look up.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\infra\mssql\migrations\*.sql">
      <LogicalName>SarhSql.%(Filename)%(Extension)</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\infra\mssql\bootstrap-login.sql">
      <LogicalName>SarhSql.bootstrap-login.sql</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>

</Project>
